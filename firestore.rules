rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function myUser() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function isSuperAdmin() { return signedIn() && myUser().role == 'super_admin'; }
    function isAdmin() { return signedIn() && myUser().role in ['admin','super_admin']; }
    function isStaff() { return signedIn() && myUser().role in ['admin','employee','super_admin']; }
    function myGroupId() { return myUser().get('groupId', 'unassigned'); }
    function sameGroup(data) { return isSuperAdmin() || (isStaff() && data.groupId == myGroupId()); }

    match /users/{uid} {
      allow create: if (isSuperAdmin() && request.resource.data.role in ['admin','employee']) || (signedIn() && request.auth.uid == uid && request.resource.data.role == 'employee');
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin() || resource.data.position == 'Team Leader');
      allow update: if signedIn() && (
        (request.auth.uid == uid && request.resource.data.role == resource.data.role) ||
        (isSuperAdmin() && (
          (resource.data.role == 'super_admin' && request.resource.data.role == 'super_admin') ||
          (resource.data.role != 'super_admin' && request.resource.data.role in ['admin','employee'])
        )) ||
        (isAdmin() && resource.data.role != 'super_admin' && request.resource.data.role != 'super_admin')
      );
      allow delete: if isSuperAdmin();
    }

    match /groups/{groupId} {
      allow read: if signedIn();
      allow create, update, delete: if isSuperAdmin();
    }

    match /branches/{branchId} {
      allow read: if isStaff();
      allow create: if isSuperAdmin() || (isStaff() && request.resource.data.groupId == myGroupId());
      allow update, delete: if isSuperAdmin() || (isStaff() && resource.data.groupId == myGroupId() && request.resource.data.groupId == myGroupId());
    }

    match /accomplishments/{accomplishmentId} {
      allow create: if isSuperAdmin() || (isStaff() && request.resource.data.groupId == myGroupId());
      allow read: if isStaff();
      allow update, delete: if isSuperAdmin() || (isStaff() && resource.data.groupId == myGroupId() && request.resource.data.groupId == myGroupId());
    }

    match /retirements/{retirementId} {
      allow create: if isSuperAdmin() || (isStaff() && request.resource.data.groupId == myGroupId());
      allow read: if isStaff();
      allow update, delete: if isAdmin();
    }

    match /jobOrders/{jobOrderId} {
      allow create: if isStaff() && request.resource.data.groupId == myGroupId();
      allow read: if sameGroup(resource.data);
      allow update: if sameGroup(resource.data) && request.resource.data.groupId == resource.data.groupId;
      allow delete: if sameGroup(resource.data);
    }


    match /jobDone/{jobDoneId} {
      allow create: if isStaff() && request.resource.data.groupId == myGroupId();
      allow read: if sameGroup(resource.data);
      allow update: if sameGroup(resource.data) && request.resource.data.groupId == resource.data.groupId;
      allow delete: if isSuperAdmin();
    }

    match /partsInventory/{itemId} {
      allow read: if isStaff();
      allow create, delete: if isSuperAdmin();
      // Staff may only decrement inventory by exactly 1 during a repair workflow.
      allow update: if isSuperAdmin() || (isStaff()
        && request.resource.data.quantity == resource.data.quantity - 1
        && request.resource.data.itemCode == resource.data.itemCode
        && request.resource.data.controlSerialNo == resource.data.controlSerialNo);
    }

    match /usedParts/{usedPartId} {
      allow read, update, delete: if isSuperAdmin();
      allow create: if isSuperAdmin() || (isStaff() && request.resource.data.groupId == myGroupId());
    }


    match /activeSessions/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.sessionId is string
        && request.resource.data.sessionId.size() >= 16
        && request.resource.data.sessionId.size() <= 128;
      allow delete: if false;
    }

    match /auditLogs/{logId} {
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow read: if isSuperAdmin();
      allow update, delete: if false;
    }
  }
}
